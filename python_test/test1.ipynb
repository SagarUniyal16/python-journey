     "text": [
      "Please order the ice cream you want to consume\n",
      "Ordered Ice cream is Chocolate\n",
      "Ordered Ice cream is Strawberry\n"
     ]
    }
   ],
   "source": [
    "def icecream_order():\n",
    "    print(\"Please order the ice cream you want to consume\")\n",
    "    order=yield\n",
    "    while True:\n",
    "        print(f\"Ordered Ice cream is {order}\")\n",
    "        order=yield\n",
    "\n",
    "order=icecream_order()\n",
    "next(order)\n",
    "order.send(\"Chocolate\")\n",
    "order.send(\"Strawberry\")"
   ]
  },
